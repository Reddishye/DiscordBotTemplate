# Optional. These override config.yml. A blank value does not override.
# BOT_TOKEN wins over DISCORD_TOKEN when both are set.

BOT_TOKEN=change-me
BOT_DATABASE_TYPE=SQLITE
BOT_DATABASE_PASSWORD=
BOT_COMMANDS_SCOPE=GUILD
BOT_COMMANDS_GUILD_ID=0
# Leave unset for a single shard. Set when Discord requires more.
# BOT_SHARDS=1
# CONFIG_FILE=config.yml
